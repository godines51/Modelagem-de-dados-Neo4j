// Criando gêneros
CREATE (g1:Genre {name: "Action"}),
       (g2:Genre {name: "Drama"}),
       (g3:Genre {name: "Comedy"});

// Criando usuários
CREATE (u1:User {name: "Alice"}),
       (u2:User {name: "Bruno"});

// Criando filmes
CREATE (m1:Movie {title: "Matrix"}),
       (m2:Movie {title: "Interstellar"});

// Criando séries
CREATE (s1:Series {title: "Breaking Bad"}),
       (s2:Series {title: "The Office"});

// Criando atores
CREATE (a1:Actor {name: "Keanu Reeves"}),
       (a2:Actor {name: "Bryan Cranston"}),
       (a3:Actor {name: "Steve Carell"});

// Criando diretores
CREATE (d1:Director {name: "Wachowski Sisters"}),
       (d2:Director {name: "Christopher Nolan"});

// Relacionamentos: Filmes e séries por gênero
MATCH (m1:Movie {title: "Matrix"}), (g1:Genre {name: "Action"})
CREATE (m1)-[:IN_GENRE]->(g1);

MATCH (m2:Movie {title: "Interstellar"}), (g2:Genre {name: "Drama"})
CREATE (m2)-[:IN_GENRE]->(g2);

MATCH (s1:Series {title: "Breaking Bad"}), (g2:Genre {name: "Drama"})
CREATE (s1)-[:IN_GENRE]->(g2);

MATCH (s2:Series {title: "The Office"}), (g3:Genre {name: "Comedy"})
CREATE (s2)-[:IN_GENRE]->(g3);

// Relacionamentos de atuação
MATCH (a1:Actor {name: "Keanu Reeves"}), (m1:Movie {title: "Matrix"})
CREATE (a1)-[:ACTED_IN]->(m1);

MATCH (a2:Actor {name: "Bryan Cranston"}), (s1:Series {title: "Breaking Bad"})
CREATE (a2)-[:ACTED_IN]->(s1);

MATCH (a3:Actor {name: "Steve Carell"}), (s2:Series {title: "The Office"})
CREATE (a3)-[:ACTED_IN]->(s2);

// Relacionamentos de direção
MATCH (d1:Director {name: "Wachowski Sisters"}), (m1:Movie {title: "Matrix"})
CREATE (d1)-[:DIRECTED]->(m1);

MATCH (d2:Director {name: "Christopher Nolan"}), (m2:Movie {title: "Interstellar"})
CREATE (d2)-[:DIRECTED]->(m2);

// Relacionamentos de "assistiu", com rating
MATCH (u1:User {name: "Alice"}), (m1:Movie {title: "Matrix"})
CREATE (u1)-[:WATCHED {rating: 5}]->(m1);

MATCH (u2:User {name: "Bruno"}), (s1:Series {title: "Breaking Bad"})
CREATE (u2)-[:WATCHED {rating: 4}]->(s1);

// ---------------------------------------------------------
// 1. CONSTRAINTS E ÍNDICES
// ---------------------------------------------------------
CREATE CONSTRAINT user_id_unique IF NOT EXISTS
FOR (u:User) REQUIRE u.id IS UNIQUE;

CREATE CONSTRAINT track_id_unique IF NOT EXISTS
FOR (t:Track) REQUIRE t.id IS UNIQUE;

CREATE CONSTRAINT artist_id_unique IF NOT EXISTS
FOR (a:Artist) REQUIRE a.id IS UNIQUE;

CREATE CONSTRAINT genre_id_unique IF NOT EXISTS
FOR (g:Genre) REQUIRE g.id IS UNIQUE;

// ---------------------------------------------------------
// 2. LIMPAR O GRAFO (OPCIONAL EM AMBIENTE DE TESTE)
// ---------------------------------------------------------
MATCH (n) DETACH DELETE n;

// Recria as constraints após limpar (caso use o bloco acima)
CREATE CONSTRAINT user_id_unique IF NOT EXISTS
FOR (u:User) REQUIRE u.id IS UNIQUE;

CREATE CONSTRAINT track_id_unique IF NOT EXISTS
FOR (t:Track) REQUIRE t.id IS UNIQUE;

CREATE CONSTRAINT artist_id_unique IF NOT EXISTS
FOR (a:Artist) REQUIRE a.id IS UNIQUE;

CREATE CONSTRAINT genre_id_unique IF NOT EXISTS
FOR (g:Genre) REQUIRE g.id IS UNIQUE;

// ---------------------------------------------------------
// 3. CRIAÇÃO DE NÓS (USUÁRIOS, ARTISTAS, MÚSICAS, GÊNEROS)
// ---------------------------------------------------------
CREATE
// Usuários
  (u1:User {id:'u1', name:'Gabriel'}),
  (u2:User {id:'u2', name:'Ana'}),
  (u3:User {id:'u3', name:'João'}),

// Artistas
  (a1:Artist {id:'a1', name:'The Synth Lords'}),
  (a2:Artist {id:'a2', name:'Lo-Fi Beats'}),
  (a3:Artist {id:'a3', name:'Rock Titans'}),

// Gêneros
  (g1:Genre {id:'g1', name:'Eletrônica'}),
  (g2:Genre {id:'g2', name:'Lo-Fi'}),
  (g3:Genre {id:'g3', name:'Rock'}),

// Músicas
  (t1:Track {id:'t1', title:'Neon Nights', durationSec:210}),
  (t2:Track {id:'t2', title:'Digital Dreams', durationSec:195}),
  (t3:Track {id:'t3', title:'Lo-Fi Rain', durationSec:180}),
  (t4:Track {id:'t4', title:'Coffee Study', durationSec:200}),
  (t5:Track {id:'t5', title:'Heavy Riffs', durationSec:230}),
  (t6:Track {id:'t6', title:'Arena Anthem', durationSec:240});

// ---------------------------------------------------------
// 4. RELACIONAMENTOS ESTÁTICOS (MÚSICA–ARTISTA–GÊNERO)
// ---------------------------------------------------------
MATCH (a1:Artist {id:'a1'}), (a2:Artist {id:'a2'}), (a3:Artist {id:'a3'}),
      (g1:Genre {id:'g1'}), (g2:Genre {id:'g2'}), (g3:Genre {id:'g3'}),
      (t1:Track {id:'t1'}), (t2:Track {id:'t2'}), (t3:Track {id:'t3'}),
      (t4:Track {id:'t4'}), (t5:Track {id:'t5'}), (t6:Track {id:'t6'})
CREATE
  (t1)-[:PERFORMED_BY]->(a1),
  (t2)-[:PERFORMED_BY]->(a1),
  (t3)-[:PERFORMED_BY]->(a2),
  (t4)-[:PERFORMED_BY]->(a2),
  (t5)-[:PERFORMED_BY]->(a3),
  (t6)-[:PERFORMED_BY]->(a3),

  (t1)-[:IN_GENRE]->(g1),
  (t2)-[:IN_GENRE]->(g1),
  (t3)-[:IN_GENRE]->(g2),
  (t4)-[:IN_GENRE]->(g2),
  (t5)-[:IN_GENRE]->(g3),
  (t6)-[:IN_GENRE]->(g3);

// ---------------------------------------------------------
// 5. INTERAÇÕES DO USUÁRIO (ESCUTAR, CURTIR, SEGUIR)
//    Relações com propriedades (ex.: plays, lastPlayed, rating)
// ---------------------------------------------------------
MATCH
  (u1:User {id:'u1'}), (u2:User {id:'u2'}), (u3:User {id:'u3'}),
  (a1:Artist {id:'a1'}), (a2:Artist {id:'a2'}), (a3:Artist {id:'a3'}),
  (t1:Track {id:'t1'}), (t2:Track {id:'t2'}), (t3:Track {id:'t3'}),
  (t4:Track {id:'t4'}), (t5:Track {id:'t5'}), (t6:Track {id:'t6'})
CREATE
  // Gabriel
  (u1)-[:LISTENED {plays:15, lastPlayed:datetime('2025-11-20T10:00:00'), rating:4.5}]->(t1),
  (u1)-[:LISTENED {plays:10, lastPlayed:datetime('2025-11-20T11:00:00'), rating:4.0}]->(t2),
  (u1)-[:LISTENED {plays:5,  lastPlayed:datetime('2025-11-21T09:30:00'), rating:5.0}]->(t3),
  (u1)-[:LIKED]->(t1),
  (u1)-[:LIKED]->(t3),
  (u1)-[:FOLLOWS]->(a1),

  // Ana
  (u2)-[:LISTENED {plays:20, lastPlayed:datetime('2025-11-20T09:00:00'), rating:5.0}]->(t3),
  (u2)-[:LISTENED {plays:18, lastPlayed:datetime('2025-11-21T09:15:00'), rating:4.5}]->(t4),
  (u2)-[:LISTENED {plays:3,  lastPlayed:datetime('2025-11-19T18:00:00'), rating:3.5}]->(t1),
  (u2)-[:LIKED]->(t3),
  (u2)-[:LIKED]->(t4),
  (u2)-[:FOLLOWS]->(a2),

  // João
  (u3)-[:LISTENED {plays:12, lastPlayed:datetime('2025-11-18T20:00:00'), rating:4.0}]->(t5),
  (u3)-[:LISTENED {plays:8,  lastPlayed:datetime('2025-11-19T21:00:00'), rating:4.5}]->(t6),
  (u3)-[:LISTENED {plays:4,  lastPlayed:datetime('2025-11-19T22:00:00'), rating:3.0}]->(t2),
  (u3)-[:LIKED]->(t5),
  (u3)-[:FOLLOWS]->(a3);

// ---------------------------------------------------------
// 6. CONSULTAS DE RECOMENDAÇÃO
// ---------------------------------------------------------

// 6.1. Recomendar músicas do mesmo gênero das que o usuário mais ouve
// (exclui músicas já escutadas)
MATCH (u:User {id:'u1'})-[:LISTENED]->(t:Track)-[:IN_GENRE]->(g:Genre)
WITH u, g, count(*) AS playsPorGenero
ORDER BY playsPorGenero DESC
LIMIT 1
MATCH (g)<-[:IN_GENRE]-(rec:Track)
WHERE NOT (u)-[:LISTENED]->(rec)
RETURN rec.title AS recomendacaoPorGenero, g.name AS genero
ORDER BY rec.title;

// 6.2. Recomendar músicas de artistas seguidos pelo usuário
// que ele ainda não ouviu
MATCH (u:User {id:'u1'})-[:FOLLOWS]->(a:Artist)<-[:PERFORMED_BY]-(t:Track)
WHERE NOT (u)-[:LISTENED]->(t)
RETURN t.title AS recomendacaoPorArtista, a.name AS artista
ORDER BY t.title;

// 6.3. “Usuários parecidos comigo” (mesmos likes) e músicas que eles gostam
// mas eu ainda não ouvi (recomendação colaborativa simples)
MATCH (me:User {id:'u1'})-[:LIKED]->(m:Track)<-[:LIKED]-(other:User)
WHERE me <> other
WITH me, other, count(m) AS intersecaoLikes
WHERE intersecaoLikes >= 1   // limiar de similaridade
MATCH (other)-[:LIKED]->(rec:Track)
WHERE NOT (me)-[:LISTENED]->(rec)
RETURN rec.title AS recomendacaoColaborativa,
       other.name AS usuarioSimilar,
       intersecaoLikes
ORDER BY intersecaoLikes DESC, rec.title;

// 6.4. Top N músicas mais tocadas no sistema (popularidade global)
MATCH (:User)-[l:LISTENED]->(t:Track)
RETURN t.title AS musica, sum(l.plays) AS totalPlays
ORDER BY totalPlays DESC
LIMIT 5;

// 6.5. Últimas músicas tocadas por um usuário (histórico recente)
MATCH (u:User {id:'u1'})-[l:LISTENED]->(t:Track)
RETURN t.title AS musica, l.lastPlayed AS ultimaVez
ORDER BY l.lastPlayed DESC
LIMIT 10;
